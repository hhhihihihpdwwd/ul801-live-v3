
name: Generate free Swedish UL 801 announcements

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  announcements:
    runs-on: ubuntu-latest
    timeout-minutes: 25

    steps:
      - name: Projekt herunterladen
        uses: actions/checkout@v4

      - name: Python einrichten
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Sprachgenerator installieren
        run: python -m pip install 'edge-tts>=7,<9'

      - name: Schwedische Ansagen erstellen
        run: python make_swedish_announcements.py

      - name: Ansagen speichern
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add public/announcements/
          if ! git diff --cached --quiet; then
            git commit -m "Add Swedish stop announcements"
            git push
          fi
